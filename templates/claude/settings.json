{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "dev-lite": {
      "source": { "source": "github", "repo": "amyteq/dev-lite", "ref": "v0" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "dev-skills@dev-lite": true,
    "dev-planning@dev-lite": true,
    "dev-hooks@dev-lite": true
  },
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Read(./.env.production)",
      "Read(~/.ssh/**)"
    ]
  }
}
